# Docker Compose reads a local .env. Python source runs read the process environment.
VECTORFORGE_BIND_ADDRESS=127.0.0.1
VECTORFORGE_FRONTEND_PORT=8080
VECTORFORGE_API_PORT=8000
VECTORFORGE_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Same-origin Nginx deployments need no cross-origin access.
VECTORFORGE_CORS_ORIGINS=
VECTORFORGE_ENABLE_DOCS=true
VECTORFORGE_ENABLE_BENCHMARKS=true
VECTORFORGE_MAX_INDEXES=16
VECTORFORGE_MAX_PENDING_JOBS=2
VECTORFORGE_JOB_TIMEOUT=180
# Only for compose.auth.yaml. Create a bcrypt htpasswd file yourself.
# VECTORFORGE_HTPASSWD_FILE=/absolute/private/path/vectorforge.htpasswd
# Source-run-only settings (Compose supplies its own container paths):
# VECTORFORGE_ENV=development
# VECTORFORGE_API_HOST=127.0.0.1
# VECTORFORGE_DATA_DIR=/absolute/path/vectorforge/data
# VECTORFORGE_RESULTS_DIR=/absolute/path/vectorforge/results
